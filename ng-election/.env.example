# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER prefix with NEXT_PUBLIC_. Used by scripts/ and server actions.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only Situation Room video adapter. The provider must return JSON video metadata.
SITUATION_ROOM_MEDIA_SOURCE_URL=
SITUATION_ROOM_MEDIA_SOURCE_TOKEN=

# Optional election countdown overrides (ISO 8601 timestamps; Africa/Lagos / UTC+01:00).
# Defaults match the dates currently listed on INEC's online election calendar.
NEXT_PUBLIC_PRESIDENTIAL_ELECTION_DATE=2027-01-16T00:00:00+01:00
NEXT_PUBLIC_GOVERNORSHIP_ELECTION_DATE=2027-02-06T00:00:00+01:00
